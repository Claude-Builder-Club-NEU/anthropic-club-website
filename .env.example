# Copy to .env for local development, and set the same keys in Netlify.
#
# ALL THREE ARE OPTIONAL. Every one of them degrades to a defined state rather
# than breaking the build, so a fresh clone runs with no .env at all. In
# practice only VITE_WEB3FORMS_KEY changes what a visitor sees.

# Web3Forms access key. Powers TWO forms, both of which post to the same inbox:
# the workshop pitch at /events/pitch, and the newsletter unsubscribe page at
# the random path in src/lib/unsubscribe.js.
# Without it neither renders a field that would silently fail to send: the pitch
# flow is replaced by a link to the interest form, and unsubscribe says it is
# not switched on and points at a board member.
# NOTE: any VITE_-prefixed variable is inlined into the client bundle at build
# time, so this value is publicly readable in the shipped JavaScript. That is
# how Web3Forms is designed to work: the key identifies the destination inbox,
# it does not authorise reading anything. Restrict abuse in the Web3Forms
# dashboard (allowed domains, rate limits), not by hiding the key.
VITE_WEB3FORMS_KEY=

# Public Google Calendar ID. OPTIONAL — leave it unset and the build falls back
# to CALENDAR_ID in src/lib/links.js, which is committed, so events work with no
# configuration anywhere. Set this only to point a build at a different calendar.
GCAL_ID=

# GA4 measurement ID, e.g. G-XXXXXXXXXX. Still outstanding.
VITE_GA_ID=

# --- Attendance (Supabase) ------------------------------------------------
# Both are OPTIONAL. Without them /attendance renders an explanatory panel
# instead of a form, in the same way the pitch form degrades without its key.
#
# The anon key is PUBLIC by design and is inlined into the client bundle. That
# is safe here and only here because supabase/schema.sql enables row-level
# security on both tables and grants the anon role no policy whatsoever, so
# this key can reach exactly two functions and can read no roster.
#
# NEVER put the service_role key in this file, in any VITE_ variable, or in
# this repository. It bypasses row-level security entirely.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
