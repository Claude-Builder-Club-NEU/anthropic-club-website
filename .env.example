# Copy to .env for local development, and set the same keys in Netlify.
#
# ALL THREE ARE OPTIONAL. Every one of them degrades to a defined state rather
# than breaking the build, so a fresh clone runs with no .env at all. In
# practice only VITE_WEB3FORMS_KEY changes what a visitor sees.

# Web3Forms access key. Powers the workshop pitch form at /events/pitch.
# Without it the flow is replaced by a link to the interest form rather than a
# form that would silently fail to send.
# NOTE: any VITE_-prefixed variable is inlined into the client bundle at build
# time, so this value is publicly readable in the shipped JavaScript. That is
# how Web3Forms is designed to work: the key identifies the destination inbox,
# it does not authorise reading anything. Restrict abuse in the Web3Forms
# dashboard (allowed domains, rate limits), not by hiding the key.
VITE_WEB3FORMS_KEY=

# Public Google Calendar ID. OPTIONAL — leave it unset and the build falls back
# to CALENDAR_ID in src/lib/links.js, which is committed, so events work with no
# configuration anywhere. Set this only to point a build at a different calendar.
GCAL_ID=

# GA4 measurement ID, e.g. G-XXXXXXXXXX. Still outstanding.
VITE_GA_ID=
