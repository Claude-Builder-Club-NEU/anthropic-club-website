{
  "name": "anthropic-club-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-events.mjs && node scripts/build-headshots.mjs && node scripts/build-blog-images.mjs && node scripts/build-team-photos.mjs",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "postbuild": "npm run build:hackathon",
    "build:hackathon": "npm --prefix hackathon ci --no-audit --no-fund && npm --prefix hackathon run build && node scripts/copy-hackathon.mjs",
    "og": "node scripts/build-og-image.mjs",
    "images": "node scripts/build-blog-images.mjs && node scripts/build-team-photos.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:db": "node supabase/signups.test.mjs",
    "test:hackathon-db": "node supabase/hackathon.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.2"
  }
}
