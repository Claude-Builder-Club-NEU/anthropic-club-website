# Only for `npm run dev`. Nothing here is read by the production build.
#
# With these unset, the dev server answers /hackathon/api/* from an in-memory
# mock (dev/api.mjs): the whole signup flow works, and "checkout" skips Stripe.
# Set them in .env.local (gitignored) to run the REAL functions against your
# Supabase project and Stripe TEST mode instead.
#
# Production reads the same names from Netlify's environment variables; see the
# top of ../netlify/lib/hackathon.mjs.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A sk_test_ key. Never a live key on a laptop.
STRIPE_SECRET_KEY=

# Mock only: start the mock with this many seats taken. 100 shows the waitlist.
HACKATHON_MOCK_TAKEN=
